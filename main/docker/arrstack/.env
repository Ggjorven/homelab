# General settings
TZ=Europe/Amsterdam
PUID=1000
PGID=1000

# Directories
MOVIES_FOLDER=/mnt/nas/path/to/movies # REQUIRED
SERIES_FOLDER=/mnt/nas/path/to/series # REQUIRED
MUSIC_FOLDER=/mnt/nas/path/to/music # REQUIRED

# Subtitle sync
SUBTITLE_SYNC_MAX_JOBS=1 # Higher is faster processing but more CPU usage (significantly more)
