# General settings
TZ=Europe/Amsterdam
PUID=1000
PGID=1000

# Directories
MOVIES_FOLDER=/mnt/nas/path/to/movies # REQUIRED
SERIES_FOLDER=/mnt/nas/path/to/series # REQUIRED
MUSIC_FOLDER=/mnt/nas/path/to/music # REQUIRED

# Soularr settings
SOULARR_DOWNLOAD_INTERVAL=300 # Seconds
SLSKD_API_KEY=apikey # REQUIRED
SLSKD_DOWNLOAD_DIRECTORY=/mnt/nas/path/to/slskd/downloads # REQUIRED
