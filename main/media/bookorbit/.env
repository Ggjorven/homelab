EBOOKS_FOLDER=/mnt/media/books/ebooks
AUDIOBOOKS_FOLDER=/mnt/media/books/audiobooks

# Should either be the reverse proxy domain or http://vmbr0-ip:3131, where you replace vmbr0-ip with the LAN IP for this LXC container
APP_URL=https://bookorbit.local.mydomain.com

APP_SECRET=changeme
APP_SETUP_SECRET=changeme

# DATABASE_USERNAME=bookorbit
DATABASE_PASSWORD=changeme
