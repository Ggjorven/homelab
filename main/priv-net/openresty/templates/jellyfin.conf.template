upstream jellyfin {
    server 172.20.101.10:8096;
    keepalive 16;
}

server {
	listen      443 ssl;
    listen [::]:443 ssl;
    http2       on;
    server_name jellyfin.${LOCAL_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${LOCAL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${LOCAL_DOMAIN}/privkey.pem;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff"                             always;
    add_header X-Frame-Options           "SAMEORIGIN"                          always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"     always;

    # Jellyfin-specific tuning
    # Large uploads (e.g. subtitle files), long streams, no output buffering
    client_max_body_size    20G;
    proxy_buffering         off;
    proxy_request_buffering off;
    proxy_read_timeout      600s;

    location / {
        proxy_pass http://jellyfin;
    }
}
